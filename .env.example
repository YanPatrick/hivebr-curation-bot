# caminho do arquivo que guarda o ultimo bloco processado (aponte para o
# volume persistente em producao, ex: /data/lastBlockHive.txt)
BLOCK_FILE=

# diretorio onde staff.json, users.json, blacklist.json, auto.json,
# partners.json e partner-vote-weight.txt sao lidos/gravados. Em producao
# (Railway), aponte para o mount path de um Volume (ex: /data) para que
# essas listas sobrevivam a cada deploy. Deixe em branco para usar a raiz
# do projeto (uso local/dev).
DATA_DIR=

# token do shift-bot
DISCORD_TOKEN=

# ID do canal de teste
DISCORD_CHANNEL_ID=

# curation account
HIVE_ACCOUNT=

# posting key
HIVE_PRIVATE_KEY=

# opcional: janela em que o bot fica DESLIGADO (horario de Brasilia), para
# economizar RAM no Railway. Ex: 01-09 = desliga 01:00, volta 09:00. Posts
# publicados nesse periodo sao processados quando o bot volta (ele retoma do
# BLOCK_FILE). Deixe em branco para rodar 24h.
# ATENCAO: so ative junto com um Cron Schedule no Railway (Settings > Cron
# Schedule) no horario de volta em UTC. Para 01-09 use: 0 12 * * *
# Sem o cron, o bot desliga a noite e NAO volta sozinho.
QUIET_HOURS=
