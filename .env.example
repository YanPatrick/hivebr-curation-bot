# caminho do arquivo que guarda o ultimo bloco processado (aponte para o
# volume persistente em producao, ex: /data/lastBlockHive.txt)
BLOCK_FILE=

# diretorio onde staff.json, users.json, blacklist.json, auto.json,
# partners.json e partner-vote-weight.txt sao lidos/gravados. Em producao
# (Railway), aponte para o mount path de um Volume (ex: /data) para que
# essas listas sobrevivam a cada deploy. Deixe em branco para usar a raiz
# do projeto (uso local/dev).
DATA_DIR=

# token do shift-bot
DISCORD_TOKEN=

# ID do canal de teste
DISCORD_CHANNEL_ID=

# curation account
HIVE_ACCOUNT=

# posting key
HIVE_PRIVATE_KEY=

# opcional: janela em que o bot DORME (horario de Brasilia), para economizar
# RAM no Railway. Ex: 02-09 = dorme 02:00, acorda 09:00. Posts publicados
# nesse periodo sao processados quando o bot acorda (ele retoma do
# BLOCK_FILE). Deixe em branco para rodar 24h.
# ATENCAO: so ative depois de ligar o Serverless no servico do bot e de criar
# o servico despertador no Railway (passo a passo em
# docs/superpowers/specs/2026-11-21-night-sleep-design.md). Sem o despertador,
# o bot dorme a noite e so acorda com uma requisicao HTTP.
QUIET_HOURS=

# opcional: porta do servidor HTTP que o despertador chama (so sobe quando
# QUIET_HOURS esta definido). Padrao: 8080.
PORT=
